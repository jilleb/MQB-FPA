Printf(" 0xB5C     40  unk_phev_B5C[20] ushort               (research)             -\n");
Printf(" 0xBB0     10  unk_phev_BB0                          (research)             -\n");
Printf(" 0xBBA     20  unk_phev_BBA[10] ushort               (research)             -\n");
Printf(" 0xBCE     10  unk_phev_BCE                          (research)             -\n");
Printf(" 0xBD8    128  unk_phev_BD8_table[4x32]              state-transitions     40%%\n");
